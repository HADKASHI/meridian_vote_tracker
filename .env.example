# Copy to .env to change anything below. Nothing is required: compose works without a .env.

# Host ports (bound to 127.0.0.1 only).
WEB_PORT=8080
API_PORT=5080
DB_PORT=5433
AZURITE_PORT=10000

# Folder holding member_states.csv, mounted read-only into the migrate service.
DATA_DIR=./candidate_data

# The local PostgreSQL password (a throwaway value for the compose database).
POSTGRES_PASSWORD=meridian_local

# Real Azure Blob Storage instead of Azurite: a full connection string.
BLOB_CONNECTION_STRING=

# How many imports may run at once (1 keeps upload order: the earlier file is approved first).
IMPORTS_MAX_CONCURRENT=1

# Reading scanned voting sheets (the PDF bonus): an Azure AI Document Intelligence resource. Both are secrets:
# keep them in your own .env (git ignores it), never in a committed file. Without them a sheet fails once,
# saying no reader is configured, and Retry works after you set them. The endpoint looks like
# https://<resource-name>.cognitiveservices.azure.com/ and the key is under "Keys and Endpoint" in the Azure portal.
DOCINTEL_ENDPOINT=
DOCINTEL_KEY=

# Application Insights: tracing and logs switch on only when this is set.
APPLICATIONINSIGHTS_CONNECTION_STRING=
