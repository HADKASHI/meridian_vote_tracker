{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Blob": {
    "Container": "imports"
  },
  "Imports": {
    "MaxConcurrent": 1,
    "MaxUploadBytes": 209715200
  },
  "Jobs": {
    "PollInterval": "00:00:01",
    "HeartbeatInterval": "00:00:10",
    "StaleAfter": "00:01:00",
    "MaxAttempts": 3,
    "ImportTimeout": "00:30:00",
    "SnapshotTimeout": "00:10:00"
  }
}
